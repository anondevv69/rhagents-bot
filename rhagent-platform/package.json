{
  "name": "rhagent-platform",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:bot": "npm -w apps/bot run dev",
    "dev:dash": "npm -w apps/dashboard run dev",
    "build": "npm -w packages/shared run build && npm -w apps/bot run build && npm -w apps/dashboard run build",
    "start:bot": "npm -w apps/bot run start",
    "start:dash": "npm -w apps/dashboard run start"
  },
  "engines": { "node": ">=20" }
}
