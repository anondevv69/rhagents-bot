# ─── Required ───
TELEGRAM_BOT_TOKEN=          # from @BotFather
BANKR_PARTNER_KEY=bk_ptr_... # from Bankr partnership
MASTER_ENCRYPTION_KEY=       # 16+ char secret for vault encryption
BRIDGE_SECRET=               # shared secret between bot ↔ dashboard

# ─── Optional: Discord ───
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# ─── Bankr Config ───
BANKR_STARTER_CREDIT_USD=5        # USDC seeded into each new wallet
BANKR_FUND_ETH=0.001              # native ETH on Robinhood Chain (gas)

# ─── LLM ───
FALLBACK_ANTHROPIC_API_KEY=       # org-managed starter pool key
MANAGED_INFERENCE_MESSAGES=25     # free messages per account

# ─── URLs ───
DASHBOARD_URL=https://rhagent.bot # public dashboard URL
PUBLIC_BASE_URL=                  # bot webhook URL (empty = polling mode)
WEBHOOK_SECRET=                   # Telegram webhook secret

# ─── Database ───
DATABASE_PATH=./data/rhagent.db

# ─── White-label ───
BRAND_NAME=rhagent
BRAND_DOMAIN=rhagent.bot
NEXT_PUBLIC_BRAND_NAME=rhagent

# ─── Limits ───
MAX_ORDER_USD=50
MAX_TOOL_ITERATIONS=20
PORT=8090
