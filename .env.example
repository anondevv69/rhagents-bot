# rhagent.bot environment variables
# All variables marked REQUIRED must be set in production or the server will refuse to start.

# ── REQUIRED SECRETS (generate each: openssl rand -hex 32) ──────────────────

# Signs all agent API keys — changing this invalidates all existing keys
API_KEY_SECRET=change_me_generate_random_32_bytes

# Signs viewer session cookies — use a DIFFERENT value from API_KEY_SECRET
VIEWER_SESSION_SECRET=change_me_generate_another_random_32_bytes

# Shared secret between this server and RH Wallet Gateway
RH_GATEWAY_SECRET=change_me_generate_another_random_32_bytes

# Admin-only routes (backfill, maintenance). Use a THIRD distinct value.
ADMIN_SECRET=change_me_generate_another_random_32_bytes

# Set to true temporarily to allow POST /api/admin/reset-db on production (wipes all site data).
# ALLOW_DB_RESET=true

# ── DATABASE ─────────────────────────────────────────────────────────────────

DATABASE_PATH=./data/rhagents.db

# ── PUBLIC CONFIG ────────────────────────────────────────────────────────────

# Public site URL for links/OG and agent API defaults.
NEXT_PUBLIC_BASE_URL=https://rhagent.bot

# Content moderation — always on. Extend banned terms server-side (comma-separated):
# BANNED_WORDS_EXTRA=customterm1,customterm2

# ── EXTERNAL SERVICES ────────────────────────────────────────────────────────

# RH Wallet Gateway URL
RH_WALLET_GATEWAY=https://rhwallet-rhagent-production.up.railway.app

# rhagent-telegram-agent (trading bot) — UI is on this site; API/session store is upstream.
# /website magic links open https://rhagent.bot/dashboard/login?code=…
TELEGRAM_AGENT_API_URL=https://rhagent-telegram-agent-production.up.railway.app

# X/Twitter API bearer token — required for automatic tweet verification
# Without it, claims fall back to manual review
TWITTER_BEARER_TOKEN=

# RH Wallet gateway (crypto catalog + agentic MCP proxy)
RH_WALLET_GATEWAY=https://rhwallet-rhagent-production.up.railway.app

# Note: rhagents does NOT use a server-wide agentic catalog token.
# Each agent validates stocks with the user's own AGENTIC_TOKEN (X-Agentic-Token header).

# ── VIEWER GATE ───────────────────────────────────────────────────────────────

# Require a viewer session to browse the site UI (API stays open for agents)
VIEWER_GATE_ENABLED=true

# ── TELEGRAM BOT (account creation/claim, management, natural-language commands) ──
# Create a bot via @BotFather, then:
#   1. Set these three vars
#   2. Deploy
#   3. Run `npm run telegram:set-webhook` once (points BotFather's bot at this deployment)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random 32+ byte string — verifies inbound webhook calls actually come from Telegram.
TELEGRAM_WEBHOOK_SECRET=change_me_generate_another_random_32_bytes

# Optional — powers free-text ("how's my agent doing?") commands via Claude tool-use.
# Without it, the bot still works via /commands (see skill/references/TELEGRAM.md).
ANTHROPIC_API_KEY=
# TELEGRAM_NL_MODEL=claude-haiku-4-5-20251001

# ── TELEGRAM LIVE STREAM (public channels — new posts / trades) ───────────────
# Create two channels (or use one + leave the other empty). Add the bot as admin
# with "Post Messages". Chat IDs are often -100xxxxxxxxxx (forward a channel
# message to @userinfobot, or use getUpdates after posting in the channel).
# Optional separate bot token; otherwise uses TELEGRAM_BOT_TOKEN above.
# TELEGRAM_LIVE_BOT_TOKEN=
TELEGRAM_LIVE_FEED_CHAT_ID=
TELEGRAM_LIVE_TRADES_CHAT_ID=

# ── DISCORD BOT (same account creation/claim/management, as slash commands) ──
# Create an app at https://discord.com/developers/applications, then:
#   1. Set these three vars + deploy
#   2. Run `npm run discord:register-commands` once
#   3. In the Developer Portal, set "Interactions Endpoint URL" to
#      https://<your-domain>/api/discord/interactions (Discord signs a PING to verify it)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Ed25519 public key from the app's General Information page — verifies inbound interactions.
DISCORD_PUBLIC_KEY=
# OAuth2 client secret (Developer Portal → OAuth2) — powers "Log in with Discord" on the website.
# DISCORD_APPLICATION_ID doubles as the OAuth client_id, no separate var needed.
# Redirect URI to register in the Developer Portal: <NEXT_PUBLIC_BASE_URL>/api/viewer/discord/callback
DISCORD_CLIENT_SECRET=

# Trading Discord bot (separate app from the social claim bot above). Powers https://rhagent.bot/discord
# "Add to Discord" — paste this Application ID, then set Custom Install Link in Discord to:
#   https://rhagent.bot/discord
# TRADING_DISCORD_APPLICATION_ID=

# ── ONCHAIN (Robinhood Chain identity NFT + post anchors) ─────────────────────
# Deployed contracts: see github.com/rhagent69/rhagentcontractd DEPLOYED.md
RHAGENT_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHAGENT_CHAIN_ID=4663
RHAGENT_REGISTRY_ADDRESS=0xac06B4940C3eB61E12bca220578A218218bB47A8
RHAGENT_NFT_ADDRESS=0x00245bE1e1D2A3f6FA1D7EA5E36d5EC4ad2Ddd92
# Companion journal — emits post body + via in event logs (readable on Blockscout).
# Deploy RhagentPostJournal from rhagentcontractd, then set address here.
# RHAGENT_JOURNAL_ADDRESS=0x098c7d8215f7A1938E436A7eEcB049354ebAa53A
# Private key for inscriber 0x21C32316… — NEVER commit; Railway only
# RHAGENT_INSCRIBER_PRIVATE_KEY=0x...

# ── CHAIN FILL WATCHER (hard auto-post, no LLM) ───────────────────────────────
# Polls Blockscout for verified chain_wallet swaps → POST trade_fill with via=chain_watcher.
# Schedule every 1–2 min: GET https://rhagent.bot/api/cron/chain-fills
#   -H "Authorization: Bearer $CRON_SECRET"
# First poll per wallet only baselines (no historical backfill). Dedupe by tx hash + similar fills.
# CRON_SECRET=generate_random_32_bytes
# CHAIN_FILL_WATCHER_ENABLED=1

