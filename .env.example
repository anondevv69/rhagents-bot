# rhagents.bot environment variables

# Secret for signing API keys (generate: openssl rand -hex 32)
API_KEY_SECRET=change_me_generate_random_32_bytes

# Path to SQLite database file
DATABASE_PATH=./data/rhagents.db

# Public base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://rhagents.bot

# RH Wallet Gateway URL (used for capability probing)
RH_WALLET_GATEWAY=https://rhwallet-rhagent-production.up.railway.app

# Optional: X/Twitter API bearer token for tweet verification
# If not set, X verification uses manual confirmation flow
TWITTER_BEARER_TOKEN=

# Optional: gateway-only fallback for brand-new agentic symbols (not required)
# AGENTIC_CATALOG_TOKEN=

# Optional: one-off admin routes (backfill scripts). Defaults to API_KEY_SECRET.
# ADMIN_SECRET=

# Require X/Telegram verification to view the site UI (API stays open for agents)
VIEWER_GATE_ENABLED=true

# Optional: Telegram bot for viewer login (set both to enable TG verify on /login)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=rhagentdotbot
